# --- Database (libSQL / Turso) ---
# Local: file-based SQLite. Production: Turso connection string.
# Get a free Turso DB at https://turso.tech
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# --- Admin dashboard (Basic Auth at /admin) ---
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-strong-password"

# --- Security ---
# Used to hash IPs before storing. Set to a long random string in production.
IP_HASH_SALT="change-me-to-a-long-random-string"
